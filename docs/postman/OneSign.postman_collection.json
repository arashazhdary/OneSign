{
  "info": {
    "name": "OneSign API",
    "description": "Core OneSign endpoints for developer sandbox workflows. Import into Postman and set `baseUrl`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7001" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Discovery",
      "item": [
        {
          "name": "OpenID Configuration",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/.well-known/openid-configuration"
          }
        },
        {
          "name": "JWKS",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/.well-known/jwks.json"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"YourPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Admin Tenants",
      "item": [
        {
          "name": "List Tenants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/admin/tenants?pageNumber=1&pageSize=20"
          }
        },
        {
          "name": "Create Sandbox Tenant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Developer Sandbox\",\n  \"slug\": \"dev-sandbox\",\n  \"isSandbox\": true\n}"
            },
            "url": "{{baseUrl}}/api/admin/tenants"
          }
        }
      ]
    },
    {
      "name": "OpenAPI",
      "item": [
        {
          "name": "Swagger JSON",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/swagger/v1/swagger.json"
          }
        }
      ]
    }
  ]
}
