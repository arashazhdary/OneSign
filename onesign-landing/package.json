{
  "name": "onesign-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "clean": "rm -rf .next node_modules",
    "analyze": "ANALYZE=true next build",
    "docker:build": "docker build -t onesign-landing:latest .",
    "docker:run": "docker run -d -p 3001:3001 --name onesign-landing onesign-landing:latest",
    "docker:stop": "docker stop onesign-landing && docker rm onesign-landing",
    "docker:dev": "docker-compose up landing-dev",
    "docker:prod": "docker-compose up landing",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop onesign-landing",
    "pm2:restart": "pm2 restart onesign-landing",
    "pm2:logs": "pm2 logs onesign-landing",
    "health": "curl http://localhost:3001/api/health",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "perf": "bash scripts/performance-check.sh",
    "backup": "bash scripts/backup.sh",
    "deploy": "bash scripts/deploy.sh",
    "prepare": "husky install",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "next": "16.0.3",
    "next-intl": "^4.5.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.13.0",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "typescript": "^5"
  }
}
