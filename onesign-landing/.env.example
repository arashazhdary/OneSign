# ==============================================================================
# OneSign Landing Page - Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development
# All NEXT_PUBLIC_* variables are exposed to the browser

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Public URL of the application (used for sitemap, SEO, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Application name (displayed in metadata and branding)
NEXT_PUBLIC_APP_NAME=OneSign Landing

# Default locale for the application (en, fa)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Environment name (for Sentry and logging)
NEXT_PUBLIC_ENV=development

# ------------------------------------------------------------------------------
# Google Analytics & Tracking
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Legacy Google Analytics Tracking ID (Format: UA-XXXXXXXXX-X)
NEXT_PUBLIC_GA_TRACKING_ID=

# Google Tag Manager ID (Format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# ------------------------------------------------------------------------------
# Error Tracking & Monitoring
# ------------------------------------------------------------------------------
# Sentry DSN for error tracking
# Get this from: https://sentry.io/settings/[org]/projects/[project]/keys/
NEXT_PUBLIC_SENTRY_DSN=

# Enable/disable Sentry error tracking
NEXT_PUBLIC_SENTRY_ENABLED=false

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
# Enable/disable analytics tracking (GA, GTM)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Enable/disable dark mode theme switching
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Enable/disable new landing page features
NEXT_PUBLIC_ENABLE_NEW_LANDING=true

# Enable/disable contact form
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true

# Enable/disable live chat widget
NEXT_PUBLIC_ENABLE_LIVE_CHAT=false

# Enable/disable newsletter subscription
NEXT_PUBLIC_ENABLE_NEWSLETTER=false

# Enable/disable blog functionality
NEXT_PUBLIC_ENABLE_BLOG=false

# Enable/disable Progressive Web App (PWA) features
NEXT_PUBLIC_ENABLE_PWA=true

# ------------------------------------------------------------------------------
# Progressive Web App (PWA)
# ------------------------------------------------------------------------------
# VAPID public key for push notifications
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# API Configuration (Future Use)
# ------------------------------------------------------------------------------
# Base URL for backend API (if needed)
# API_BASE_URL=http://localhost:7000

# API request timeout in milliseconds
# API_TIMEOUT=30000

# API authentication token (server-side only)
# API_SECRET_KEY=

# ------------------------------------------------------------------------------
# External Services (Optional)
# ------------------------------------------------------------------------------
# Live chat service credentials (e.g., Intercom, Drift, Crisp)
# NEXT_PUBLIC_LIVE_CHAT_APP_ID=

# Newsletter service API key (e.g., Mailchimp, ConvertKit)
# NEWSLETTER_API_KEY=

# Email service credentials (for contact form)
# EMAIL_SERVICE_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_TO_ADDRESS=contact@yourdomain.com

# ------------------------------------------------------------------------------
# Database (Future Use)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/onesign_landing

# Redis cache connection (for rate limiting, sessions, etc.)
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Security & Rate Limiting
# ------------------------------------------------------------------------------
# Rate limiting: Maximum requests per IP per window
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ------------------------------------------------------------------------------
# CI/CD & Testing
# ------------------------------------------------------------------------------
# Set to true when running in CI/CD environment
# CI=false

# Playwright test configuration
# PLAYWRIGHT_BASE_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Development & Debugging
# ------------------------------------------------------------------------------
# Enable verbose logging
# DEBUG=false

# Show development tools in production (not recommended)
# NEXT_PUBLIC_SHOW_DEV_TOOLS=false

# ------------------------------------------------------------------------------
# Content & Media
# ------------------------------------------------------------------------------
# CDN URL for static assets (optional)
# NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# Maximum image upload size in MB
# MAX_IMAGE_SIZE_MB=5

# Allowed image formats (comma-separated)
# ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp,avif

# ------------------------------------------------------------------------------
# Localization & Currency
# ------------------------------------------------------------------------------
# Currency conversion API key (e.g., exchangerate-api.com)
# NEXT_PUBLIC_CURRENCY_API_KEY=

# Default currency code (USD, EUR, GBP, etc.)
# NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# ------------------------------------------------------------------------------
# Performance Monitoring
# ------------------------------------------------------------------------------
# Enable Web Vitals reporting to analytics
# NEXT_PUBLIC_ENABLE_WEB_VITALS=true

# Sample rate for performance monitoring (0.0 to 1.0)
# NEXT_PUBLIC_PERFORMANCE_SAMPLE_RATE=0.1

# ------------------------------------------------------------------------------
# Notes
# ------------------------------------------------------------------------------
# 1. Never commit .env.local or .env.production to version control
# 2. Use .env.example as template for all environments
# 3. NEXT_PUBLIC_* variables are exposed to the browser - never put secrets
# 4. Server-side only variables (no NEXT_PUBLIC_ prefix) are kept secure
# 5. For production, use environment variables from your hosting platform
#    (Vercel, Netlify, etc.) instead of .env files
