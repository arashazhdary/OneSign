# ==============================================================================
# OneSign Landing Page - Production Environment Variables
# ==============================================================================
# Use this as a template for production deployment
# Configure these in your hosting platform's environment variables

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001

# Public URL of your production application
NEXT_PUBLIC_APP_URL=https://landing.yourdomain.com

# Application name
NEXT_PUBLIC_APP_NAME=OneSign Landing

# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Environment name (production, staging, etc.)
NEXT_PUBLIC_ENV=production

# ------------------------------------------------------------------------------
# Google Analytics & Tracking (Production)
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Legacy Google Analytics Tracking ID
NEXT_PUBLIC_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Google Tag Manager ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ------------------------------------------------------------------------------
# Error Tracking & Monitoring (Production)
# ------------------------------------------------------------------------------
# Sentry DSN for production error tracking
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxx@sentry.io/xxxxxxx

# Enable Sentry in production
NEXT_PUBLIC_SENTRY_ENABLED=true

# ------------------------------------------------------------------------------
# Feature Flags (Production)
# ------------------------------------------------------------------------------
# Enable analytics in production
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Enable dark mode
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Enable new landing page
NEXT_PUBLIC_ENABLE_NEW_LANDING=true

# Enable contact form
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true

# Enable live chat (set based on your needs)
NEXT_PUBLIC_ENABLE_LIVE_CHAT=true

# Enable newsletter (set based on your needs)
NEXT_PUBLIC_ENABLE_NEWSLETTER=true

# Enable blog (set based on your needs)
NEXT_PUBLIC_ENABLE_BLOG=true

# Enable PWA features
NEXT_PUBLIC_ENABLE_PWA=true

# ------------------------------------------------------------------------------
# Progressive Web App (PWA)
# ------------------------------------------------------------------------------
# VAPID public key for push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE

# ------------------------------------------------------------------------------
# API Configuration (Production)
# ------------------------------------------------------------------------------
# Production API base URL
API_BASE_URL=https://api.yourdomain.com

# API timeout
API_TIMEOUT=30000

# API authentication (server-side only - KEEP SECRET!)
API_SECRET_KEY=your_secret_api_key_here

# ------------------------------------------------------------------------------
# External Services
# ------------------------------------------------------------------------------
# Live chat service
NEXT_PUBLIC_LIVE_CHAT_APP_ID=your_chat_app_id

# Newsletter service (server-side only)
NEWSLETTER_API_KEY=your_newsletter_api_key

# Email service (server-side only)
EMAIL_SERVICE_API_KEY=your_email_service_api_key
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_TO_ADDRESS=contact@yourdomain.com

# ------------------------------------------------------------------------------
# Database (Production)
# ------------------------------------------------------------------------------
# PostgreSQL connection (server-side only - KEEP SECRET!)
DATABASE_URL=postgresql://user:password@host:5432/onesign_landing

# Redis connection (server-side only - KEEP SECRET!)
REDIS_URL=redis://user:password@host:6379

# ------------------------------------------------------------------------------
# Security & Rate Limiting
# ------------------------------------------------------------------------------
# Rate limiting configuration
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# CORS allowed origins
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ------------------------------------------------------------------------------
# Performance Monitoring
# ------------------------------------------------------------------------------
# Enable Web Vitals reporting
NEXT_PUBLIC_ENABLE_WEB_VITALS=true

# Performance sample rate (0.1 = 10% of users)
NEXT_PUBLIC_PERFORMANCE_SAMPLE_RATE=0.1

# ------------------------------------------------------------------------------
# Content & Media
# ------------------------------------------------------------------------------
# CDN URL for static assets
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# Media upload limits
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp,avif

# ------------------------------------------------------------------------------
# Localization & Currency
# ------------------------------------------------------------------------------
# Currency API key
NEXT_PUBLIC_CURRENCY_API_KEY=your_currency_api_key

# Default currency
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# ------------------------------------------------------------------------------
# Production Security Notes
# ------------------------------------------------------------------------------
# 1. NEVER expose secrets with NEXT_PUBLIC_ prefix
# 2. Use your hosting platform's secret management (Vercel, Netlify, etc.)
# 3. Rotate API keys and secrets regularly
# 4. Enable HTTPS only in production
# 5. Configure proper CORS origins
# 6. Set up proper rate limiting
# 7. Enable all monitoring and error tracking
